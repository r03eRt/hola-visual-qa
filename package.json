{
  "name": "hola-visual-qa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test tests/unit",
    "test:integration": "playwright test tests/integration",
    "test:visual": "playwright test tests/visual",
    "test:update": "playwright test tests/visual --update-snapshots",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report reports/html",
    "orchestrate": "tsx src/orchestrator/cli.ts",
    "dashboard": "tsx src/dashboard/cli.ts",
    "plan": "tsx src/scenarios/plan-cli.ts",
    "baseline:update": "tsx src/baseline/cli.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "lint": "eslint .",
    "validate": "npm run typecheck && npm run test:visual",
    "feature:new": "node scripts/new-feature.mjs",
    "ticket:new": "node scripts/new-ticket.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "dotenv": "17.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "eslint": "10.8.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
